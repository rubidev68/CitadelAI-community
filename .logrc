# Log viewing aliases for CitadelAI
# Add to your ~/.bashrc or ~/.zshrc:
# source /path/to/CitadelAI/.logrc

# Set default compose file (change if needed)
export COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.prod.yml}"

alias logs='./scripts/view-logs.sh -c $COMPOSE_FILE'
alias logs-follow='./scripts/view-logs.sh -c $COMPOSE_FILE -f'
alias logs-error='./scripts/view-logs.sh -c $COMPOSE_FILE -l ERROR'
alias logs-user='./scripts/view-logs.sh -c $COMPOSE_FILE user-backend'
alias logs-admin='./scripts/view-logs.sh -c $COMPOSE_FILE admin-backend'
alias logs-pretty='docker-compose -f docker-compose.prod.yml logs | ./scripts/logs'

# Usage:
#   logs user-backend          # View user-backend logs
#   logs-follow user-backend   # Follow user-backend logs
#   logs-error user-backend    # View only errors
#   logs-user                  # Quick access to user-backend
#   logs-admin                 # Quick access to admin-backend
#   
#   # Change compose file
#   export COMPOSE_FILE=docker-compose.yml
#   logs user-backend
