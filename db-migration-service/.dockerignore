# Node modules (will be installed in container)
node_modules
npm-debug.log
yarn-error.log

# Build outputs
dist
*.map
*.d.ts

# Development files
.git
.gitignore
*.md
README.md
.env*
.vscode
.idea

# Test files
*.test.ts
*.test.js
*.spec.ts
*.spec.js
__tests__
coverage
.nyc_output

# Migration backups (don't copy these)
.migration-backup-*

# Other services (we only copy specific migration directories)
admin/backend/src
admin/backend/dist
admin/backend/node_modules
admin/backend/coverage
admin/interface
user/backend/src
user/backend/dist
user/backend/node_modules
user/backend/coverage
user/interface
superadmin-dashboard/backend/src
superadmin-dashboard/backend/dist
superadmin-dashboard/backend/node_modules
superadmin-dashboard/frontend
cron-scheduler/src
cron-scheduler/dist
cron-scheduler/node_modules
crawling-service/src
crawling-service/dist
crawling-service/node_modules

# Only include what we need: prisma directories and SQL migrations
!admin/backend/prisma
!user/backend/prisma
!superadmin-dashboard/backend/migrations
!cron-scheduler/prisma
!crawling-service/prisma
