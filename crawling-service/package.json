{
  "name": "crawling-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "prisma:deploy": "npx prisma migrate deploy",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run --coverage",
    "test:concurrency": "node test-concurrency.js",
    "docker:build": "./build.sh",
    "docker:build:standard": "docker build -t crawling-service:latest .",
    "docker:build:optimized": "docker build -f Dockerfile.optimized -t crawling-service:optimized .",
    "docker:run": "docker run -p 3001:3001 crawling-service:latest",
    "docker:clean": "docker rmi crawling-service:latest crawling-service:optimized 2>/dev/null || true"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^1.2.1",
    "@prisma/client": "^5.17.0",
    "@shared/config": "file:../shared/config",
    "@shared/middleware": "file:../shared/middleware",
    "@shared/services": "file:../shared/services",
    "@shared/utils": "file:../shared/utils",
    "@types/turndown": "^5.0.5",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "graphql": "^16.11.0",
    "helmet": "^8.0.0",
    "langchain": "1.2.7",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.22.0",
    "puppeteer": "^24.22.2",
    "turndown": "^7.2.1",
    "vite": "7.2.4",
    "weaviate-ts-client": "^2.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.23",
    "@types/node": "^16.11.7",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "^4.0.12",
    "eslint": "^9.36.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.4.0",
    "typescript": "^5.1.0",
    "vitest": "^4.0.12"
  }
}
