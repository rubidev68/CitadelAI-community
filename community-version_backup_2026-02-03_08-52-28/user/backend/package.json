    "@langchain/openai": "^0.0.30",
    "@prisma/client": "^5.17.0",
    "@shared/config": "file:../../shared/config",
    "@shared/middleware": "file:../../shared/middleware",
    "@shared/services": "file:../../shared/services",
    "@shared/types": "file:../../shared/types",
    "@shared/utils": "file:../../shared/utils",
    "@types/turndown": "^5.0.5",
    "axios": "^1.12.2",
    "bcrypt": "^5.0.1",
