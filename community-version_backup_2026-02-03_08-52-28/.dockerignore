# .dockerignore for builds with context: .
# This applies to ALL services, so only exclude things safe for all builds

# Exclude node_modules everywhere (will be installed during build)
**/node_modules
node_modules

# Exclude build artifacts (will be built during build)
**/dist
**/build
dist
build

# Exclude git
.git
.gitignore
.gitattributes

# Exclude IDE files
.vscode
.idea
*.swp
*.swo

# Exclude documentation (except READMEs)
*.md
!README.md
documentation/
docs/

# Exclude test files
**/__tests__
**/test
**/tests
**/*.test.*
**/*.spec.*

# Exclude environment files
.env
.env.*
!.env.example

# Exclude logs
*.log
logs/

# Exclude temporary files
tmp/
temp/
*.tmp

# Exclude backups
backups/
*.backup
.migration-backup-*
.migration-report-*
.validation-*

# Exclude coverage
coverage/
.nyc_output/

# Exclude large files
*.zip
*.tar
*.tar.gz
*.gz

# Exclude OS files
.DS_Store
Thumbs.db

# IMPORTANT: We DO NOT exclude:
# - Any service source code (admin/backend/src, user/backend/src, etc.) - needed by service builds
# - Any prisma directories - needed for migrations
# - db-migration-service directory - needed for migration service build
# - shared directories - needed by services
# - Any service directories - needed by their respective builds
