datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User-related models
model User {
  id               String          @id @default(cuid())
  email            String          @unique
  password         String
  name             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  chatSessions     ChatSession[]
  defaultChatbot   Chatbot?        @relation("DefaultChatbot", fields: [defaultChatbotId], references: [id])
  defaultChatbotId String?
  chatbotAccesses  ChatbotAccess[]
  aiUsages         AIUsage[]
}

model ChatSession {
  id           String        @id @default(cuid())
  title        String        @default("New Chat")
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  chatbotId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatMessages ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(cuid())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  chatSessionId String
  role          String
  content       String
  createdAt     DateTime    @default(now())
}

// Admin-related models
model AdminUser {
  id                            String        @id @default(cuid())
  email                         String        @unique
  password                      String
  name                          String?
  role                          String        @default("ARCHITECT")
  company                       String?
  tutorialCompleted             Boolean       @default(false)
  emailVerified                 Boolean       @default(false)
  emailVerificationToken        String?
  emailVerificationTokenExpires DateTime?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  chatbots                      Chatbot[]
  testUserId                    String?       @unique
  subscription                  Subscription?
  testDatasets                  TestDataset[]

  // Two-Factor Authentication fields
  twoFactorEnabled        Boolean  @default(false)
  twoFactorSecret         String?
  twoFactorBackupCodes    String[] // Array of hashed backup codes
  twoFactorSetupCompleted Boolean  @default(false)

  // Password Reset fields
  passwordResetToken        String?
  passwordResetTokenExpires DateTime?
  passwordResetRequestedAt  DateTime?

  // Proposal relationships
  createdProposals  Proposal[] @relation("CreatedProposals")
  assignedProposals Proposal[] @relation("AssignedProposals")

  // Instance relationships
  createdInstances DedicatedInstance[] @relation("CreatedInstances")

  // Payment links
  paymentLinks PaymentLink[]
  
  // AI call tracking
  aiCalls AICall[]
  
  // AI Usage tracking
  aiUsages AIUsage[]
  
  // Custom AI providers
  customProviders CustomProvider[]
  
  // File upload quota
  uploadQuota UserUploadQuota?

  // Integration credentials
  credentials IntegrationCredential[]
}

// Shared models
model Chatbot {
  id              String           @id @default(cuid())
  name            String
  status          ChatbotStatus    @default(INACTIVE)
  ownerId         String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  blocks          Block[]
  connections     Connection[]
  accesses        ChatbotAccess[]
  websiteContexts WebsiteContext[]
  defaultForUsers User[]           @relation("DefaultChatbot")
  owner           AdminUser        @relation(fields: [ownerId], references: [id])
  testDatasets    TestDataset[]
  aiCalls         AICall[]
  apiTokens       ApiToken[]
  slackIntegrations SlackIntegration[]
  aiUsages        AIUsage[]
}

model WebsiteContext {
  id                String    @id @default(cuid())
  chatbot           Chatbot   @relation(fields: [chatbotId], references: [id])
  chatbotId         String
  blockId           String    @unique
  url               String
  recursive         Boolean   @default(false)
  maxDepth          Int       @default(3)
  crawlingStatus    Json?
  lastCrawledAt     DateTime?
  crawledPagesCount Int?
  cronEnabled       Boolean   @default(false)
  cronSchedule      String? // Cron expression (e.g., "0 0 * * *" for daily at midnight)
  cronTimezone      String?   @default("UTC") // Timezone for cron execution
  nextCrawlAt       DateTime? // Next scheduled crawl time
}

model ChatbotAccess {
  id         String   @id @default(cuid())
  chatbot    Chatbot  @relation(fields: [chatbotId], references: [id])
  chatbotId  String
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  userEmail  String
  assignedAt DateTime @default(now())

  @@unique([chatbotId, userEmail])
}

model Block {
  id              String       @id @default(cuid())
  chatbot         Chatbot      @relation(fields: [chatbotId], references: [id])
  chatbotId       String
  type            BlockType
  subtype         String
  title           String
  position        Json
  properties      Json
  fromConnections Connection[] @relation("FromConnections")
  toConnections   Connection[] @relation("ToConnections")
  apiTokens       ApiToken[]
  slackIntegration SlackIntegration?
}

model Connection {
  id            String    @id @default(cuid())
  chatbot       Chatbot   @relation(fields: [chatbotId], references: [id])
  chatbotId     String
  fromBlock     Block     @relation("FromConnections", fields: [fromBlockId], references: [id])
  fromBlockId   String
  toBlock       Block     @relation("ToConnections", fields: [toBlockId], references: [id])
  toBlockId     String
  fromDirection Direction
  toDirection   Direction
}

// Test datasets for TestLLM blocks
model TestDataset {
  id        String    @id @default(cuid())
  name      String
  owner     AdminUser @relation(fields: [ownerId], references: [id])
  ownerId   String
  chatbot   Chatbot?  @relation(fields: [chatbotId], references: [id])
  chatbotId String?
  examples  Json // Array<{question: string, answer: string, expectedSources?: string[]}>
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@index([chatbotId])
}

// Billing models
model Subscription {
  id                 String             @id @default(cuid())
  adminUser          AdminUser          @relation(fields: [adminUserId], references: [id])
  adminUserId        String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Stripe integration fields
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String? // Stripe Price ID for the plan
  stripePaymentLinkId  String? // For custom plans via payment links
  paymentMethodId      String? // Last used payment method
  lastPaymentDate      DateTime?
  nextPaymentDate      DateTime?

  // Relations
  dedicatedInstances DedicatedInstance[]
  paymentLinks       PaymentLink[]

  @@unique([adminUserId])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Float
  currency    String   @default("USD")
  interval    String   @default("month") // month, year
  maxChatbots Int? // null = unlimited
  maxUsers    Int? // null = unlimited
  maxMessages Int? // null = unlimited (rolling 30-day limit)
  maxPages    Int? // null = unlimited (total indexed pages limit)
  maxConcurrentSessions Int? // null = unlimited (concurrent widget sessions per chatbot)
  features    Json? // Additional features as JSON
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Stripe integration
  stripeProductId String? @unique // Stripe Product ID
  stripePriceId   String? @unique // Stripe Price ID

  subscriptions             Subscription[]
  dedicatedInstances        DedicatedInstance[]
  instanceResourceTemplates InstanceResourceTemplate[]
  paymentLinks              PaymentLink[]
}

// Enums
enum ChatbotStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum BlockType {
  CONTEXT
  LOGIC
  ACTION
  FRONTEND
  TEST
}

enum Direction {
  LEFT
  RIGHT
  TOP
  BOTTOM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

// System monitoring model
model SystemMetrics {
  id                String    @id @default(cuid())
  serviceName       String
  serviceType       String
  status            String
  alertLevel        String
  cpuUsage          Float?
  memoryUsage       Float?
  responseTime      Float?
  requestsPerSecond Float?
  errorRate         Float?
  activeConnections Int?
  lastHealthCheck   DateTime?
  buildDate         String?
  healthCheckStatus String?
  customMetrics     Json?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Enterprise contact requests
model EnterpriseContactRequest {
  id          String                  @id @default(cuid())
  email       String
  phone       String?
  name        String?
  company     String?
  message     String?
  status      EnterpriseContactStatus @default(PENDING)
  adminUserId String? // Assigned superadmin
  notes       String? // Internal notes
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  // Proposal relationship
  proposals Proposal[]
}

enum EnterpriseContactStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
  CONVERTED
}

// Proposal and billing models
model Proposal {
  id            String  @id @default(cuid())
  title         String
  description   String?
  companyName   String
  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  // Proposal details
  proposalType   ProposalType @default(CUSTOM)
  features       String[] // Array of features included
  customFeatures String? // Additional custom features

  // Pricing
  basePrice      Float // Base price in USD
  setupFee       Float? // One-time setup fee
  monthlyFee     Float? // Recurring monthly fee
  annualDiscount Float? // Discount for annual payment
  currency       String @default("USD")

  // Validity and terms
  validUntil       DateTime? // Proposal expiration date
  contractDuration Int? // Contract duration in months
  paymentTerms     String? // Payment terms (e.g., "Net 30", "50% upfront")

  // Status and workflow
  status   ProposalStatus   @default(DRAFT)
  priority ProposalPriority @default(MEDIUM)

  // Relationships
  enterpriseRequestId String? // Link to original enterprise request
  enterpriseRequest   EnterpriseContactRequest? @relation(fields: [enterpriseRequestId], references: [id])
  createdByAdminId    String // Admin who created the proposal
  createdByAdmin      AdminUser                 @relation("CreatedProposals", fields: [createdByAdminId], references: [id])
  assignedToAdminId   String? // Admin assigned to follow up
  assignedToAdmin     AdminUser?                @relation("AssignedProposals", fields: [assignedToAdminId], references: [id])

  // Billing plan (if approved)
  billingPlanId String? // Link to billing plan if approved
  billingPlan   BillingPlan? @relation

  // Dedicated instance (if created)
  dedicatedInstance DedicatedInstance?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime? // When proposal was sent to client
  respondedAt DateTime? // When client responded
  approvedAt  DateTime? // When proposal was approved

  // Internal notes
  internalNotes String? // Internal notes for the team
  clientNotes   String? // Notes from client communication
}

model BillingPlan {
  id         String   @id @default(cuid())
  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  // Billing details
  planName       String
  description    String?
  basePrice      Float
  setupFee       Float?
  monthlyFee     Float?
  annualDiscount Float?
  currency       String  @default("USD")

  // Billing cycle
  billingCycle      BillingCycle @default(MONTHLY)
  contractStartDate DateTime?
  contractEndDate   DateTime?
  autoRenewal       Boolean      @default(false)

  // Status
  status BillingStatus @default(ACTIVE)

  // Payment tracking
  lastPaymentDate   DateTime?
  nextPaymentDate   DateTime?
  totalPaid         Float     @default(0)
  outstandingAmount Float     @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProposalType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum ProposalStatus {
  DRAFT
  SENT
  REVIEWED
  NEGOTIATING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProposalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_TIME
}

enum BillingStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
  OVERDUE
}

// Dedicated Instance Management
model DedicatedInstance {
  id          String @id @default(cuid())
  name        String @unique // enterprise name (e.g., "acme-corp")
  displayName String // Display name (e.g., "ACME Corporation")
  subdomain   String @unique // subdomain (e.g., "acme-corp")

  // Instance configuration
  status       InstanceStatus @default(PROVISIONING)
  resourceSpec Json // Resource specifications (CPU, memory, storage, etc.)
  customConfig Json? // Custom configuration options

  // Database configuration
  databaseUrl  String? // Dedicated database URL
  databaseName String? // Dedicated database name

  // Weaviate configuration
  weaviateUrl    String? // Dedicated Weaviate URL
  weaviateApiKey String? // Dedicated Weaviate API key

  // Docker configuration
  dockerComposeFile String? // Path to docker-compose file
  containerPrefix   String? // Prefix for container names

  // Network configuration
  internalPorts Json? // Internal port mappings
  externalPorts Json? // External port mappings

  // Relationships
  proposalId         String?           @unique // Link to proposal if created from proposal
  proposal           Proposal?         @relation(fields: [proposalId], references: [id])
  subscriptionId     String? // Link to subscription
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id])
  subscriptionPlanId String? // Link to subscription plan
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  createdByAdminId   String // Admin who created the instance
  createdByAdmin     AdminUser         @relation("CreatedInstances", fields: [createdByAdminId], references: [id])

  // Instance users (enterprise users for this instance)
  instanceUsers InstanceUser[]

  // Monitoring and health
  lastHealthCheck DateTime?
  healthStatus    InstanceHealthStatus @default(UNKNOWN)
  errorMessage    String?

  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  provisionedAt  DateTime?
  lastAccessedAt DateTime?
}

model InstanceUser {
  id         String            @id @default(cuid())
  instance   DedicatedInstance @relation(fields: [instanceId], references: [id])
  instanceId String

  // User details
  email    String
  name     String?
  password String
  role     InstanceUserRole @default(USER)

  // User preferences
  preferences Json?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@unique([instanceId, email])
}

model InstanceResourceTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Resource specifications
  cpuCores           Int  @default(2)
  memoryGB           Int  @default(4)
  storageGB          Int  @default(50)
  maxConcurrentUsers Int? // null = unlimited
  maxChatbots        Int? // null = unlimited

  // Database specifications
  databaseSizeGB      Int @default(10)
  databaseConnections Int @default(20)

  // Relations
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPlanId String?

  // Weaviate specifications
  weaviateMemoryGB  Int @default(2)
  weaviateStorageGB Int @default(20)

  // Additional features
  features Json? // Additional features as JSON
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enums for dedicated instances
enum InstanceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  UPDATING
  FAILED
  DELETED
}

enum InstanceHealthStatus {
  HEALTHY
  UNHEALTHY
  UNKNOWN
  MAINTENANCE
}

enum InstanceUserRole {
  ADMIN
  USER
  VIEWER
}

// Payment Links for custom plans
model PaymentLink {
  id                  String            @id @default(cuid())
  proposalId          String?           @unique // Link to proposal if custom
  stripePaymentLinkId String            @unique // Stripe Payment Link ID
  stripePriceId       String // Stripe Price ID
  adminUserId         String // Target admin user
  adminUser           AdminUser         @relation(fields: [adminUserId], references: [id])
  planId              String // Subscription plan ID
  plan                SubscriptionPlan  @relation(fields: [planId], references: [id])
  subscriptionId      String? // Link to subscription once completed
  subscription        Subscription?     @relation(fields: [subscriptionId], references: [id])
  status              PaymentLinkStatus @default(PENDING)
  expiresAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  completedAt         DateTime?

  @@index([adminUserId])
  @@index([stripePaymentLinkId])
  @@index([subscriptionId])
}

enum PaymentLinkStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

// AI Call Tracking model for message limit counting
model AICall {
  id        String   @id @default(cuid())
  chatbotId String
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id])
  adminUserId String // Owner of the chatbot
  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
  createdAt DateTime @default(now())
  
  // Track which type of call this was
  callType String   @default("MESSAGE") // MESSAGE, TESTLLM, FOLLOWUP
  
  @@index([adminUserId, createdAt])
  @@index([chatbotId])
}

// Invitation Code model for admin registration
model InvitationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String? // Optional label/name for the invitation code
  maxUses   Int       @default(1) // Maximum number of times this code can be used
  usedCount Int       @default(0) // Number of times this code has been used
  createdBy String? // Superadmin ID who created this code
  expiresAt DateTime? // Optional expiration date
  isActive  Boolean   @default(true) // Can be deactivated without deleting
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

// API Token model for chatbot API access
model ApiToken {
  id            String       @id @default(cuid())
  chatbot       Chatbot      @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chatbotId     String
  block         Block?       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId       String?      // Link to API block (multiple tokens can be linked to same block)
  name          String       // User-friendly token name
  token         String       @unique // Hashed token value
  tokenPrefix   String       // First 8 chars for display (e.g., "cat_xxxx")
  
  // Token type and limits
  tokenType     ApiTokenType @default(DURATION)
  expiresAt     DateTime?    // For DURATION type tokens
  maxUsage      Int?         // For USAGE type tokens
  currentUsage  Int          @default(0) // Current request count
  
  // Status
  isActive      Boolean      @default(true)
  lastUsedAt    DateTime?
  
  // Rate limiting
  rateLimitPerMinute Int?     // Per-token rate limit override (requests per minute)
  
  // Revocation
  revokedAt     DateTime?    // When token was revoked
  revokedBy     String?      // User ID who revoked the token
  revocationReason String?   // Reason for revocation
  scheduledRevocationAt DateTime? // Scheduled revocation time (for future revocation)
  
  // Metadata
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String       // Admin user ID who created the token
  
  @@index([chatbotId])
  @@index([blockId])
  @@index([token])
  @@index([isActive])
  @@index([revokedAt])
  @@index([scheduledRevocationAt])
  
  usageLogs     TokenUsageLog[]
}

model TokenUsageLog {
  id            String   @id @default(cuid())
  token         ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId       String
  endpoint      String   // API endpoint path (e.g., "/api/chat/:chatbotId")
  requestMethod String   // HTTP method (GET, POST, etc.)
  ipAddress     String?  // Client IP address
  statusCode    Int      // HTTP status code
  responseTime  Int?     // Response time in milliseconds
  timestamp     DateTime @default(now())
  
  @@index([tokenId])
  @@index([timestamp])
  @@index([tokenId, timestamp])
  @@index([endpoint])
}

enum ApiTokenType {
  DURATION  // Token expires after a specific date
  USAGE     // Token expires after N requests
  PERMANENT // Token never expires (admin-only)
}

// Slack Integration model for chatbot Slack bot deployment
model SlackIntegration {
  id              String   @id @default(cuid())
  chatbot         Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chatbotId       String
  block           Block?   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId         String?  @unique // Link to Slack block
  
  // User-provided Slack App credentials (encrypted)
  clientId        String   // Slack App Client ID
  clientSecret    String   // Encrypted Slack App Client Secret
  signingSecret   String   // Encrypted Slack App Signing Secret
  
  // Slack OAuth credentials (from installation)
  teamId          String?  @unique // Slack team/workspace ID (null until installed)
  teamName        String?  // Workspace name
  accessToken     String?  // Encrypted OAuth access token
  botUserId       String?  // Bot user ID in Slack
  botUserName     String?  // Bot username
  
  // Configuration
  respondToMentions  Boolean @default(true)  // Respond when bot is @mentioned
  respondInThreads   Boolean @default(true)   // Respond in threads
  respondInDMs       Boolean @default(true)   // Respond to direct messages
  respondInChannels   Boolean @default(false) // Respond in public channels (if not mentioned)
  
  // Status
  isActive        Boolean  @default(true)
  installedAt     DateTime @default(now())
  lastUsedAt      DateTime?
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  installedBy     String   // Admin user ID who installed
  
  @@index([chatbotId])
  @@index([blockId])
  @@index([teamId])
  @@index([isActive])
}

// Custom AI Provider model for storing custom provider configurations
model CustomProvider {
  id          String    @id @default(cuid())
  name        String    // User-friendly name for the provider
  ownerId     String    // Admin user who created this provider
  owner       AdminUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  baseUrl     String    // Base URL for the API (e.g., https://api.example.com)
  apiToken    String    // Encrypted API token
  modelName   String    // Model name to use (e.g., "gpt-4", "custom-model-v1")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([ownerId])
  @@index([isActive])
}

// File Upload Quota model for tracking user upload limits
model UserUploadQuota {
  id                String   @id @default(cuid())
  userId            String   @unique
  totalUploadedBytes BigInt   @default(0)
  lastUpdated       DateTime @default(now()) @updatedAt
  
  user              AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Integration Credentials for reusing configurations
model IntegrationCredential {
  id          String    @id @default(cuid())
  name        String
  type        String    // DATABASE, CLOUD
  ownerId     String
  owner       AdminUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  data        Json      // Configuration object
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([type])
}

model GlobalAIModel {
  id              String   @id @default(cuid())
  provider        String   // "openai", "gemini", "anthropic", "mistral", "custom_global"
  modelId         String   // "gpt-4"
  name            String   // "GPT-4"
  description     String?  
  icon            String?  // "openai", "gemini", etc.
  
  // Configuration
  endpoint        String?  
  apiKey          String?  // Optional encrypted key
  
  // Pricing
  inputCostPer1M  Float    @default(0)
  outputCostPer1M Float    @default(0)
  
  isVisible       Boolean  @default(true)
  isDefault       Boolean  @default(false)
  isDeprecated    Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  aiUsages        AIUsage[]
  
  @@unique([provider, modelId])
}

model AIUsage {
  id            String   @id @default(cuid())
  
  // Who used it
  adminUserId   String?
  adminUser     AdminUser? @relation(fields: [adminUserId], references: [id])
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])
  
  // What was used
  modelId       String
  globalAIModel GlobalAIModel @relation(fields: [modelId], references: [id])
  
  // Context
  chatbotId     String?
  chatbot       Chatbot?   @relation(fields: [chatbotId], references: [id])
  
  action        String   // "CHAT", "CRAWL_SUMMARY"
  
  // Usage
  inputTokens   Int
  outputTokens  Int
  totalTokens   Int
  cost          Float    
  
  timestamp     DateTime @default(now())

  @@index([adminUserId])
  @@index([timestamp])
  @@index([modelId])
}
