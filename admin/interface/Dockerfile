# Admin Frontend Dockerfile

# 1. Build stage
FROM node:20-alpine AS builder

# Accept build arguments for environment variables
ARG VITE_VERSION_TYPE
ARG VITE_FEATURE_BILLING
ARG VITE_FEATURE_ENTERPRISE
ARG VITE_FEATURE_ADVANCED_ANALYTICS
ARG VITE_FEATURE_PREMIUM_AI_MODELS
ARG VITE_FEATURE_ADMINJS_DASHBOARD
ARG VITE_API_URL
ARG VITE_ADMIN_API_URL
ARG VITE_USER_API_URL
ARG VITE_USER_INTERFACE_URL
ARG VITE_WS_URL
ARG VITE_EVENT_BUS_URL

# Set environment variables immediately
ENV VITE_VERSION_TYPE=$VITE_VERSION_TYPE
ENV VITE_FEATURE_BILLING=$VITE_FEATURE_BILLING
ENV VITE_FEATURE_ENTERPRISE=$VITE_FEATURE_ENTERPRISE
ENV VITE_FEATURE_ADVANCED_ANALYTICS=$VITE_FEATURE_ADVANCED_ANALYTICS
ENV VITE_FEATURE_PREMIUM_AI_MODELS=$VITE_FEATURE_PREMIUM_AI_MODELS
ENV VITE_FEATURE_ADMINJS_DASHBOARD=$VITE_FEATURE_ADMINJS_DASHBOARD
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ADMIN_API_URL=$VITE_ADMIN_API_URL
ENV VITE_USER_API_URL=$VITE_USER_API_URL
ENV VITE_USER_INTERFACE_URL=$VITE_USER_INTERFACE_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_EVENT_BUS_URL=$VITE_EVENT_BUS_URL

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .

# Create .env file for Vite
RUN echo "VITE_VERSION_TYPE=$VITE_VERSION_TYPE" > .env && \
    echo "VITE_FEATURE_BILLING=$VITE_FEATURE_BILLING" >> .env && \
    echo "VITE_FEATURE_ENTERPRISE=$VITE_FEATURE_ENTERPRISE" >> .env && \
    echo "VITE_FEATURE_ADVANCED_ANALYTICS=$VITE_FEATURE_ADVANCED_ANALYTICS" >> .env && \
    echo "VITE_FEATURE_PREMIUM_AI_MODELS=$VITE_FEATURE_PREMIUM_AI_MODELS" >> .env && \
    echo "VITE_FEATURE_ADMINJS_DASHBOARD=$VITE_FEATURE_ADMINJS_DASHBOARD" >> .env && \
    echo "VITE_API_URL=$VITE_API_URL" >> .env && \
    echo "VITE_ADMIN_API_URL=$VITE_ADMIN_API_URL" >> .env && \
    echo "VITE_USER_API_URL=$VITE_USER_API_URL" >> .env && \
    echo "VITE_USER_INTERFACE_URL=$VITE_USER_INTERFACE_URL" >> .env && \
    echo "VITE_WS_URL=$VITE_WS_URL" >> .env && \
    echo "VITE_EVENT_BUS_URL=$VITE_EVENT_BUS_URL" >> .env

# Debug: Show environment variables and .env file
RUN echo "Environment variables:" && env | grep VITE && echo "--- .env file ---" && cat .env

# # RUN npm run lint
RUN npm run build

# 2. Serve stage
FROM nginx:1.21-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
